// Deployed by .github/workflows/deploy-worker.yml. KV id and Access settings
// are filled in at deploy time from GitHub settings; nothing secret lives here.
{
  "name": "home-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "kv_namespaces": [
    { "binding": "HOME_DATA", "id": "__KV_ID__" }
  ],
  "observability": { "enabled": true }
}
